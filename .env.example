# ========================================================
# KIIT SOCIETYDEX — Environment Configuration
# ========================================================
# Copy this file and set the values before running the app.
#
# For this vanilla JS project, inject these as window globals
# in a <script> tag BEFORE supabase-client.js loads:
#
#   <script>
#     window.SUPABASE_URL = "https://your-project.supabase.co";
#     window.SUPABASE_ANON_KEY = "your-anon-key";
#   </script>
#
# Get these values from your Supabase project dashboard:
# https://app.supabase.com → Settings → API

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
